# متغيرات البيئة — مثال فقط
# انسخ الملف ده لـ .env.local (أو حطه في Vercel → Settings → Environment Variables)
# ⚠️ الملف ده لا يحتوي على أي مفاتيح حقيقية. مترفعش .env.local على أي مستودع عام.

# ===== Firebase (لو هتفعّل المزامنة السحابية) =====
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ===== ImageKit (رفع الصور) =====
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# ===== إعدادات التطبيق =====
APP_NAME="اعداد خدام ادمن"
APP_CURRENCY=EGP
