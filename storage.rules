rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ✅ القراءة عامة — عشان الصور تبان في الموقع والتقارير
    // ✍️ الكتابة ممنوعة من المتصفح تماماً: الرفع بيتم من الكونسول
    //    أو بمفتاح خدمة مقيّد (شوف الدليل).
    match /{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // ⬇️ لو قرّرنا بعدين إن الرفع يتم من جوه التطبيق: فعّل البلوك ده
    //    (ولازم Anonymous sign-in يكون مفعّل في Firebase Auth)
    //
    // match /uploads/{fileName} {
    //   allow read: if true;
    //   allow write: if request.auth != null
    //                && request.resource.size < 800 * 1024
    //                && request.resource.contentType.matches('image/.*');
    // }
  }
}
