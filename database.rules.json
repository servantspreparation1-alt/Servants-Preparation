{
  "rules": {
    ".read": false,
    ".write": false,
    "v8Presence": {
      ".read": "auth != null && auth.token.sessionExpiresAt > now && root.child('secureV8/accounts').child(auth.uid).child('owner').val() === true && root.child('secureV8/accounts').child(auth.uid).child('active').val() === true && auth.token.sv === root.child('secureV8/accounts').child(auth.uid).child('sessionVersion').val()",
      "$uid": {
        "$sid": {
          ".write": "auth != null && auth.token.sessionExpiresAt > now && auth.uid === $uid && root.child('secureV8/accounts').child($uid).child('active').val() === true && auth.token.sv === root.child('secureV8/accounts').child($uid).child('sessionVersion').val()",
          ".validate": "newData.hasChildren(['uid','sessionId','name','online','startedAt','lastSeen','endedAt','page','visibility','device','browser'])",
          "uid": {
            ".validate": "newData.val() === auth.uid"
          },
          "sessionId": {
            ".validate": "newData.isString() && newData.val() === $sid && newData.val().length <= 128"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 150"
          },
          "online": {
            ".validate": "newData.isBoolean()"
          },
          "startedAt": {
            ".validate": "newData.isNumber() && newData.val() <= now + 1000"
          },
          "lastSeen": {
            ".validate": "newData.isNumber() && newData.val() <= now + 1000 && newData.val() >= now - 120000"
          },
          "endedAt": {
            ".validate": "newData.isNumber() && (newData.val() === 0 || (newData.val() <= now + 1000 && newData.val() >= now - 120000))"
          },
          "page": {
            ".validate": "newData.isString() && newData.val().length <= 200"
          },
          "visibility": {
            ".validate": "newData.val() === 'active' || newData.val() === 'idle' || newData.val() === 'background'"
          },
          "device": {
            ".validate": "newData.isString() && newData.val().length <= 60"
          },
          "browser": {
            ".validate": "newData.isString() && newData.val().length <= 60"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "secureV8": {
      "audit": {
        ".indexOn": [
          "at"
        ]
      }
    }
  }
}